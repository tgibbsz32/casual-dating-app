{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark-test-harness",
  "main": "test/harness.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "spark", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "spark-photos" }],
  "vars": { "FREEBUFF_CLIENT_ID": "test-client", "APP_ORIGIN": "http://localhost:8789" }
}
